# Copy only variable names; neon deploy / neon env pull writes real database URLs.
# Never commit .env, .env.local or actual credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Generate independent secrets and retain the precision key securely.
SESSION_SECRET=
PRECISION_DATA_KEY=
# Optional providers (the journal still saves when these are not configured).
USDA_FDC_API_KEY=
API_NINJAS_KEY=
OPENAI_API_KEY=
OPENAI_SCIENCE_MODEL=
# Separate Python experimental-analysis service, if deployed.
ML_SERVICE_URL=http://localhost:8000

# Optional research simulation adapter; distinct from legacy ML_SERVICE_URL.
# Leave unset until a curated modelling backend implements RESEARCH_MODEL.md.
METABOLITE_RESEARCH_URL=
METABOLITE_RESEARCH_TOKEN=
