# Copy only variable names; neon deploy / neon env pull writes real database URLs.
# Never commit .env, .env.local or actual credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Generate independent secrets and retain the precision key securely.
SESSION_SECRET=
PRECISION_DATA_KEY=
# Optional providers (the journal still saves when these are not configured).
# Enables live generic lookup and the separate USDA Branded Foods adapter.
# Local FNDDS and private label entry work without it.
USDA_FDC_API_KEY=
API_NINJAS_KEY=
OPENAI_API_KEY=
OPENAI_SCIENCE_MODEL=
# Separate Python experimental-analysis service, if deployed.
ML_SERVICE_URL=http://localhost:8000

# Optional research simulation adapter; distinct from legacy ML_SERVICE_URL.
# Leave unset until a curated modelling backend implements RESEARCH_MODEL.md.
METABOLITE_RESEARCH_URL=
METABOLITE_RESEARCH_TOKEN=

# Optional authenticated Python service; use the same unique token on both services.
ML_SERVICE_TOKEN=
# Enable only for a deliberately private internal HTTP connection.
ML_SERVICE_ALLOW_PRIVATE_HTTP=false

# Keep disabled until the scoped Open Food Facts data/licence decision is approved.
BLOOM_OPEN_FOOD_FACTS_APPROVED=false

# Internal synthetic-review provisioning. Empty means no eligible accounts.
# Grants require userId, grantId, expiresAt, territories, reviewReference and
# allowedCapabilities including bloom.dev.preview. Never self-enroll via client.
# No restricted service is cleared by the preference switch alone.
BLOOM_EXPERIMENTAL_ENVIRONMENT=
BLOOM_EXPERIMENTAL_KILL_SWITCH=true
BLOOM_PREVIEW_TERRITORY=
BLOOM_INTERNAL_TESTERS=
