# Copy only variable names; neon deploy / neon env pull writes real database URLs.
# Never commit .env, .env.local or actual credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Generate independent secrets and retain the precision key securely.
SESSION_SECRET=
PRECISION_DATA_KEY=
# Optional providers (the journal still saves when these are not configured).
USDA_FDC_API_KEY=
API_NINJAS_KEY=
OPENAI_API_KEY=
# Separate Python experimental-analysis service, if deployed.
ML_SERVICE_URL=http://localhost:8000
