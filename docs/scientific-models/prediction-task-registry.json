      "id": "MICROBE-SUBSTRATE-UTIL-V1",
      "title": "Microbial substrate utilization classification",
      "status": "proposed_first_benchmark",
      "inputs": "strain/experiment/substrate/medium/condition",
      "target": "observed growth or non-growth on specified substrate, label and assay provenance",
      "split": "study-held-out, strain-held-out, substrate-family-held-out when enough groups",
      "metrics": "balanced accuracy, macro F1, class recall, precision, calibration/Brier, OOD abstention",
      "approvedGroundTruth": [
        "direct_experimental_measurement",
        "verified_experimental_annotation"
      ],
      "excludedAsGroundTruth": [
        "inferred_function",
